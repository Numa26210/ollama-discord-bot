# ============================================
# Ollama Discord Bot — Environment Configuration
# ============================================
# Copy this file to .env and fill in your values.

# --- Discord Bot ---
DISCORD_TOKEN=your_discord_bot_token_here

# --- PostgreSQL Database (used by Docker) ---
POSTGRES_USER=discord_bot
POSTGRES_PASSWORD=change_me_to_a_strong_password
POSTGRES_DB=discord_bot_db

# --- Database URL ---
# Docker: auto-constructed from POSTGRES_* vars in docker-compose.yml
# Local dev (SQLite): uncomment the line below
# DATABASE_URL=sqlite:///./discord_bot.db
# Local dev (PostgreSQL):
# DATABASE_URL=postgresql://discord_bot:change_me@localhost:5432/discord_bot_db
SQL_ECHO=False

# --- Ollama Configuration ---
OLLAMA_API_URL=http://localhost:11434
OLLAMA_MODEL=mistral
OLLAMA_TIMEOUT=60

# --- Bot Behavior ---
COMMAND_PREFIX=!
RESPONSE_MAX_TOKENS=256
RESPONSE_TEMPERATURE=0.7

# --- Backend API ---
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# --- CORS (comma-separated origins) ---
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# --- API Key (protects /api/bot/toggle) ---
# Leave empty to disable auth in dev
API_KEY=

# --- Frontend ---
VITE_SERVER_ID=your_discord_server_id_here
VITE_REFRESH_INTERVAL=30000
