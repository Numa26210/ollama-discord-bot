# Frontend Configuration
# Copy this file to .env and fill in your values.

# API base URL (no trailing slash)
VITE_API_URL=http://localhost:8000/api

# Discord server ID to display in the dashboard
# Leave empty or omit to auto-detect from the bot's connected server
VITE_SERVER_ID=

# Dashboard auto-refresh interval in milliseconds
VITE_REFRESH_INTERVAL=30000

# API Key for bot toggle (must match backend API_KEY)
VITE_API_KEY=
